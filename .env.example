# ═══════════════════════════════════════════════════════════
# Strategy Pulse — 한화생명 경영전략실 Strategic Intelligence Agent
#
# 이 파일을 .env 로 복사해 채운다. .env 는 git 에 올라가지 않는다.
# ═══════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────
# BotFather 로 만든 **새 봇** 토큰. 크립토 봇 토큰을 재사용하지 말 것.
TELEGRAM_BOT_TOKEN=
# 주제(Topics)가 켜진 슈퍼그룹 id. 보통 -100 으로 시작한다.
TELEGRAM_CHANNEL_ID=
USE_TOPICS=true

# ── Forum Topic thread_id (§33) ────────────────────────────
# scripts/setup_topics.py --create 가 출력한 값을 그대로 붙여 넣는다.
# 코드에 하드코딩하지 않는다.
TG_TOPIC_HANWHA_GROUP=
TG_TOPIC_MA_GOVERNANCE=
TG_TOPIC_INSURANCE_FINANCE=
TG_TOPIC_REGULATION_POLICY=
TG_TOPIC_COMPETITORS_BIGTECH=
TG_TOPIC_DIGITAL_NEWBIZ=
TG_TOPIC_GLOBAL_FINANCE=
TG_TOPIC_KEY_ISSUES=
TG_TOPIC_DAILY_BRIEF=

# ── LLM ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── 운영 (§40) ─────────────────────────────────────────────
BOT_NAME=Strategy Pulse
TIMEZONE=Asia/Seoul

# true 면 텔레그램으로 보내지 않고 판정 결과만 출력한다 (§36).
# 실운영으로 바꿀 때만 false 로 내린다.
DRY_RUN=true

# Strategic Relevance Threshold (§19)
DISCARD_THRESHOLD=50
GENERAL_TOPIC_THRESHOLD=65
IMPORTANT_THRESHOLD=80
KEY_ISSUE_THRESHOLD=85
KEY_ISSUE_DAILY_CAP=6

# Morning Brief (§23)
DAILY_BRIEF_TIME=06:55
DAILY_BRIEF_COUNT=10
DAILY_BRIEF_MAX_PER_ENTITY=4

# 기사 시간 Window (§22, 시간 단위)
MAX_AGE_HOURS=24
REGULATION_MAX_AGE_HOURS=72

# ── 선택 ───────────────────────────────────────────────────
# 텔레그램 소스 채널을 쓸 때만. 비워 두면 수집하지 않는다.
TG_WEB_CHANNELS=
TG_API_ID=
TG_API_HASH=
TG_SOURCE_CHANNELS=
